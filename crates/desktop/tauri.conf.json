{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "draftGPT",
  "version": "0.1.0",
  "identifier": "com.draftgpt.desktop",
  "build": {
    "frontendDist": "../../ui/desktop/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "draftGPT",
        "width": 380,
        "height": 760,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://ddragon.leagueoflegends.com data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
