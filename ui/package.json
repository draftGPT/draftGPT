{
  "name": "draftgpt-ui",
  "private": true,
  "type": "module",
  "description": "Svelte UIs: shared draft-ui library, the desktop panel (Tauri) and the web drafter.",
  "workspaces": ["draft-ui", "desktop", "web"],
  "scripts": {
    "types": "cargo test -q -p draft-core --features ts export_bindings",
    "check": "npm run check --workspaces",
    "test": "vitest run",
    "e2e": "playwright test",
    "build": "npm run build -w @draftgpt/desktop && npm run build -w @draftgpt/web"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.9",
    "jsdom": "31.0.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
